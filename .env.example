# Copied to .env for local runs. Process environment overrides this file.
# This file overrides configs/agent.yaml for the names listed in src/env.py.
# PLANNER_PORT / ASR_PORT are the host ports published by docker-compose.
# PLANNER_BASE_URL and ASR_URL must point at those ports.

PLANNER_MODEL=qwen-4b
PLANNER_PORT=8001
PLANNER_BASE_URL=http://127.0.0.1:8001/v1
PLANNER_API_KEY=not-needed
PLANNER_MODEL_DIR=./models/Qwen3-4B-Instruct-2507-FP8

ASR_URL=http://localhost:2043/v1/chat/completions
ASR_PORT=2043
ASR_LANGUAGE=Vietnamese
ASR_MODEL=vinai/PhoWhisper-large
ASR_SERVED_MODEL=qwen3-asr
ASR_MODEL_DIR=./models/Qwen3-ASR-1.7B

TEMPERATURE=0
MAX_STEPS=8
SPLIT=public_test
KIT_ROOT=train+public_test
CACHE_DIR=cache/transcripts
OUTPUT_PATH=outputs/submission.jsonl
USE_GOLD_TRANSCRIPT=false
